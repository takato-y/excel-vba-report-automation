root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# VBA ソースは GitHub で読めるよう UTF-8・LF で保管し、ブック作成時に CRLF へ変換する
[*.{bas,cls}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.ps1]
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
